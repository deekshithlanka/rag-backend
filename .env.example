# Same Gemini key as your chat app (GOOGLE_GENAI_API_KEY there)
GOOGLE_API_KEY=your_gemini_key

# Optional: change the answering model if this one isn't available to you
# CHAT_MODEL=gemini-3.5-flash

# Optional: leave these out to keep Qdrant local (saved in ./qdrant_data)
# QDRANT_URL=https://your-cluster.cloud.qdrant.io
# QDRANT_API_KEY=your_qdrant_key
